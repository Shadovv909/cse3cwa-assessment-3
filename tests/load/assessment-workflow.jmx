  <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;name&quot;:&quot;Load ${__UUID()}&quot;,&quot;description&quot;:&quot;Disposable JMeter synthetic record&quot;,&quot;words&quot;:[{&quot;english&quot;:&quot;ship&quot;,&quot;phonemes&quot;:[&quot;ʃ&quot;,&quot;ɪ&quot;,&quot;p&quot;]},{&quot;english&quot;:&quot;thin&quot;,&quot;phonemes&quot;:[&quot;θ&quot;,&quot;ɪ&quot;,&quot;n&quot;]},{&quot;english&quot;:&quot;chin&quot;,&quot;phonemes&quot;:[&quot;tʃ&quot;,&quot;ɪ&quot;,&quot;n&quot;]}]}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
  <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,3200)}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/word-lists</stringProp><stringProp name="HTTPSampler.method">POST</stringProp>
